# Copy to apps/web/.env.local and fill in your own values. Never commit real keys.

# Supabase (new publishable and secret keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ElevenLabs: Scribe (hearing) and Nani's voice
ELEVENLABS_API_KEY=

# Brain: claude (Claude Haiku 5.5) or kimi. Unset means the config default, kimi.
BRAIN_PROVIDER=
ANTHROPIC_API_KEY=
# Kimi k2.6, the backup on each call
KIMI_API_KEY=

# Optional: 1 builds the progress report without brain calls
PROGRESS_NO_BRAIN=
